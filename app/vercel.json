{
  "functions": {
    "api/pelecard-transactions.js": {
      "maxDuration": 30
    },
    "api/pelecard-order.js": {
      "maxDuration": 30,
      "includeFiles": "server/pelecard-live/certs/**"
    },
    "api/pelecard-live.js": {
      "maxDuration": 30,
      "includeFiles": "server/pelecard-live/certs/**"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "release/clubs-attendance-20261005": false
    }
  }
}
