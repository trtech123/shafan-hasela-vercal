{
  "functions": {
    "api/order-confirmation.js": {
      "maxDuration": 60,
      "includeFiles": "{server/order-confirmation/assets/**,public/shafan-logo.jpg,node_modules/@sparticuz/chromium/bin/**}"
    },
    "api/pelecard-transactions.js": {
      "maxDuration": 30
    },
    "api/pelecard-order.js": {
      "maxDuration": 30,
      "includeFiles": "server/pelecard-live/certs/**"
    },
    "api/pelecard-live.js": {
      "maxDuration": 30,
      "includeFiles": "server/pelecard-live/certs/**"
    }
  },
  "headers": [
    {"source":"/order-sign", "headers":[{"key":"Cache-Control","value":"no-store"},{"key":"Referrer-Policy","value":"no-referrer"},{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"X-Frame-Options","value":"DENY"}]}
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
