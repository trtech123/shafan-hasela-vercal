{
  "git": {
    "deploymentEnabled": false
  },
  "functions": {
    "api/order-confirmation.js": {
      "maxDuration": 60,
      "includeFiles": "{server/order-confirmation/assets/**,public/shafan-logo.jpg,node_modules/@sparticuz/chromium/bin/**}"
    },
    "api/pelecard-physical-worker.js": {
      "maxDuration": 360,
      "includeFiles": "server/pelecard-live/certs/**"
    },
    "api/pelecard-physical-queue.js": {
      "maxDuration": 360,
      "includeFiles": "server/pelecard-live/certs/**",
      "experimentalTriggers": [
        { "type": "queue/v2beta", "topic": "physical-j4-dispatch" }
      ]
    },
    "api/pelecard-physical-queue-smoke.js": {
      "maxDuration": 360,
      "experimentalTriggers": [
        { "type": "queue/v2beta", "topic": "physical-j4-smoke" }
      ]
    },
    "api/pelecard-physical.js": {
      "maxDuration": 30
    },
    "api/pelecard-physical-callback.js": {
      "maxDuration": 30
    },
    "api/pelecard-transactions.js": {
      "maxDuration": 30
    },
    "api/pelecard-order.js": {
      "maxDuration": 30,
      "includeFiles": "server/pelecard-live/certs/**"
    },
    "api/pelecard-pos.js": {
      "maxDuration": 30,
      "includeFiles": "server/pelecard-live/certs/**"
    },
    "api/pelecard-live.js": {
      "maxDuration": 30,
      "includeFiles": "server/pelecard-live/certs/**"
    }
  },
  "crons": [
    { "path": "/api/pelecard-physical-worker", "schedule": "* * * * *" }
  ],
  "headers": [
    { "source": "/order-sign", "headers": [
      { "key": "Cache-Control", "value": "no-store" },
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "DENY" }
    ] }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
